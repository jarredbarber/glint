{
  "name": "glint",
  "version": "0.1.0",
  "description": "Static Markdown wiki and self-contained HTML renderer",
  "main": "dist/render.js",
  "bin": {
    "glint": "./dist/cli.js"
  },
  "scripts": {
    "stage:spa": "rm -rf dist-spa && mkdir dist-spa && cp src/spa/index.html src/spa/config.js src/spa/privacy.html src/spa/terms.html dist-spa/ && node dist/cli.js skill > dist-spa/llms.txt && cp -R assets dist-spa/assets",
    "dev": "npm run build && npm run stage:spa && python3 -m http.server 8080 --directory dist-spa",
    "bundle:editor": "esbuild src/client/editor.ts --bundle --minify --outfile=assets/editor.bundle.js",
    "bundle:render": "esbuild src/browser.ts --bundle --minify --platform=browser --global-name=GlintRender --outfile=assets/glint-render.bundle.js",
    "bundle:spa": "esbuild src/spa/app.ts --bundle --minify --format=esm --outfile=assets/spa.bundle.js",
    "bundle": "npm run bundle:editor && npm run bundle:render && npm run bundle:spa",
    "build": "tsc && npm run bundle",
    "start": "npm run dev",
    "test": "tsx --test src/tests/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.9",
    "@replit/codemirror-vim": "^6.3.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.2.0",
    "commander": "^14.0.2",
    "gray-matter": "^4.0.3",
    "lru-cache": "^11.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "smol-toml": "^1.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260116.0",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "rehype-parse": "^9.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
